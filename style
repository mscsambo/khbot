/* =====================================
   LEARNING365 STYLESHEET
===================================== */

:root {
    --primary: #123B63;
    --primary-dark: #0B2A45;
    --gold: #D4AF37;
    --gold-light: #F2D27B;

    --bg: #08121F;
    --bg-secondary: #0F1E33;

    --card-bg: rgba(255, 255, 255, .08);
    --card-border: rgba(255, 255, 255, .15);

    --text: #ffffff;
    --text-muted: #cfd6e4;

    --shadow: 0 15px 40px rgba(0, 0, 0, .35);

    --radius: 20px;

    --transition: .3s ease;
}

body.light {
    --bg: #f7f9fc;
    --bg-secondary: #ffffff;

    --card-bg: rgba(255, 255, 255, .8);
    --card-border: rgba(0, 0, 0, .08);

    --text: #1d2433;
    --text-muted: #5f6b7d;

    --shadow: 0 10px 30px rgba(0, 0, 0, .08);
}

/* =====================================
   RESET
===================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--bg);
    color: var(--text);
    transition: var(--transition);
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    max-width: 100%;
    display: block;
}

ul {
    list-style: none;
}

/* =====================================
   CONTAINER
===================================== */

.container {
    width: min(1200px, 92%);
    margin: auto;
}

/* =====================================
   HEADER
===================================== */

.header {
    position: sticky;
    top: 0;
    z-index: 999;
    backdrop-filter: blur(18px);
    background: rgba(8, 18, 31, .75);
    border-bottom: 1px solid rgba(255, 255, 255, .05);
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 80px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    font-size: 1.15rem;
}

.logo img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 10px;
    ;
}

.nav-menu {
    display: flex;
    align-items: center;
    gap: 30px;
}

.nav-menu a {
    color: var(--text-muted);
    transition: var(--transition);
}

.nav-menu a:hover {
    color: var(--gold);
}

.theme-toggle {
    border: none;
    cursor: pointer;
    padding: 10px;
    border-radius: 50%;
    background: var(--card-bg);
    color: var(--text);
}

.mobile-menu-btn {
    display: none;
    font-size: 1.6rem;
    cursor: pointer;
}

/* =====================================
   HERO
===================================== */

.hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    text-align: center;
    overflow: hidden;
    padding: 80px 0;
}

/* PRODUCT DETAIL PAGES */
.product-page .hero {
    min-height: auto !important;
    padding: 60px 0 30px;
}

.product-page .hero h1 {
    font-size: 3rem;
    margin-bottom: 15px;
}

.product-page .hero p {
    margin-bottom: 15px;
}

.product-page .price {
    margin-bottom: 15px;
}

.product-page .products-section {
    padding-top: 20px;
    padding-bottom: 20px;
}

.product-page .product-card {
    max-width: 900px;
    margin: 0 auto;
}

.product-hero {
    min-height: 380px !important;
    padding: 120px 0 80px;
}

.product-page .hero {
    min-height: 420px;
    padding: 120px 0 80px;
}

.product-page .products-section {
    padding-top: 20px;
}

.hero::before {
    content: "";
    position: absolute;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, var(--gold), transparent 70%);
    opacity: .15;
    top: -250px;
    right: -150px;
}

.hero::after {
    content: "";
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #1e90ff, transparent 70%);
    opacity: .10;
    bottom: -250px;
    left: -150px;
}

.hero-content {
    position: relative;
    z-index: 2;
}

.hero-badge {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 50px;
    margin-bottom: 25px;
    background: rgba(212, 175, 55, .15);
    color: var(--gold);
    border: 1px solid rgba(212, 175, 55, .3);
}

.hero h1 {
    font-size: 4rem;
    line-height: 1.15;
    margin-bottom: 25px;
}

.hero p {
    max-width: 700px;
    margin: auto;
    color: var(--text-muted);
    font-size: 1.1rem;
}

.hero-buttons {
    margin-top: 35px;
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

/* =====================================
   BUTTONS
===================================== */

.btn {
    padding: 14px 28px;
    border-radius: 12px;
    transition: var(--transition);
    display: inline-block;
    font-weight: 600;
}

.btn-primary {
    background: linear-gradient(135deg,
            var(--gold),
            var(--gold-light));
    color: #111;
}

.btn-primary:hover {
    transform: translateY(-3px);
}

.btn-outline {
    border: 1px solid rgba(255, 255, 255, .15);
}

.btn-outline:hover {
    border-color: var(--gold);
}

/* =====================================
   FEATURES
===================================== */

.features {
    padding: 80px 0;
}

.features .container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.feature-card {
    padding: 30px;
    text-align: center;

    background: var(--card-bg);
    border: 1px solid var(--card-border);

    backdrop-filter: blur(20px);

    border-radius: var(--radius);

    box-shadow: var(--shadow);
}

.feature-card h3 {
    margin-bottom: 12px;
}

.feature-card p {
    color: var(--text-muted);
}

/* =====================================
   SECTION
===================================== */

.section-title {
    text-align: center;
    margin-bottom: 50px;
}

.section-title h2 {
    font-size: 2.5rem;
    margin-bottom: 10px;
}

.section-title p {
    color: var(--text-muted);
}

.category-title {
    font-size: 1.5rem;
    margin: 50px 0 20px;
    color: var(--gold);
}

/* =====================================
   PRODUCTS
===================================== */

.products-section {
    padding: 30px 0;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
}

.product-card {
    position: relative;

    background: var(--card-bg);
    border: 1px solid var(--card-border);

    backdrop-filter: blur(20px);

    padding: 30px;
    border-radius: var(--radius);

    transition: var(--transition);

    box-shadow: var(--shadow);
}

.product-card:hover {
    transform: translateY(-8px);
}

.product-card h3 {
    margin-bottom: 20px;
}

.product-card ul {
    margin-bottom: 20px;
}

.product-card li {
    margin-bottom: 10px;
    color: var(--text-muted);
}

.price {
    color: var(--gold);
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 20px;
}

.btn-card {
    display: inline-block;
    width: 100%;
    text-align: center;

    background: var(--primary);

    padding: 14px;

    border-radius: 12px;
    transition: var(--transition);
}

.btn-card:hover {
    background: var(--gold);
    color: #111;
}

.featured {
    border-color: rgba(212, 175, 55, .5);
}

.badge {
    position: absolute;
    top: 15px;
    right: 15px;

    background: var(--gold);
    color: #111;

    padding: 6px 12px;
    border-radius: 50px;

    font-size: .8rem;
    font-weight: 600;
}

/* =====================================
   ABOUT
===================================== */

.about-section {
    padding: 60px 0;
}

.about-text {
    max-width: 850px;
    margin: auto;
    text-align: center;
    color: var(--text-muted);
    line-height: 1.9;
}

/* =====================================
   CONTACT
===================================== */

.contact-section {
    padding: 60px 0;
}

.contact-card {
    max-width: 650px;
    margin: auto;
    text-align: center;

    background: var(--card-bg);
    border: 1px solid var(--card-border);

    padding: 50px;
    border-radius: var(--radius);

    backdrop-filter: blur(20px);
}

.contact-card p {
    color: var(--text-muted);
    margin: 15px 0 25px;
}

.product-page .hero {
    min-height: 420px;
    padding: 120px 0 80px;
}

.product-page .products-section {
    padding-top: 10px;
}

/* =====================================
   FOOTER
===================================== */

footer {
    padding: 60px 0;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, .08);
}

.footer-logo {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 10px;
}

.footer-links {
    margin: 20px 0;
    display: flex;
    justify-content: center;
    gap: 25px;
}

.footer-links a:hover {
    color: var(--gold);
}

.copyright {
    color: var(--text-muted);
    font-size: .9rem;
}

/* =====================================
   TELEGRAM FLOAT
===================================== */

.telegram-float {
    position: fixed;
    right: 25px;
    bottom: 25px;

    width: 60px;
    height: 60px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 28px;

    background: #229ED9;
    color: #fff;

    border-radius: 50%;

    box-shadow: 0 10px 25px rgba(34, 158, 217, .4);

    z-index: 9999;

    animation: float 2.5s infinite;
}

@keyframes float {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-8px);
    }
}

/* =====================================
   RESPONSIVE
===================================== */

@media(max-width:900px) {

    .hero h1 {
        font-size: 3rem;
    }

    .features .container {
        grid-template-columns: 1fr;
    }

}

@media(max-width:768px) {

    .nav-menu {
        display: none;
    }

    .mobile-menu-btn {
        display: block;
    }

    .hero h1 {
        font-size: 2.4rem;
    }

    .section-title h2 {
        font-size: 2rem;
    }

    .contact-card {
        padding: 35px 25px;
    }
}

@media(max-width:480px) {

    .hero {
        min-height: 80vh;
    }

    .hero h1 {
        font-size: 2rem;
    }

    .btn {
        width: 100%;
    }

    .hero-buttons {
        flex-direction: column;
    }
}

/* =====================================
   MOBILE MENU ACTIVE
===================================== */

.nav-menu.mobile-active {
    display: flex;
    position: absolute;
    top: 80px;
    left: 0;
    width: 100%;
    flex-direction: column;
    gap: 20px;
    padding: 30px;
    background: var(--bg-secondary);
    border-top: 1px solid rgba(255, 255, 255, .08);
    z-index: 999;
}

/* =====================================
   REVEAL ANIMATION
===================================== */

.reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: all .8s ease;
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

/* =====================================
   PRODUCT LOGOS + PRODUCT PAGE UPDATE
===================================== */
.product-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
}

.product-logo-wrap {
    width: 70px;
    height: 70px;
    border-radius: 18px;
    background: rgba(255, 255, 255, .94);
    border: 1px solid rgba(255, 255, 255, .25);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    box-shadow: 0 12px 26px rgba(0, 0, 0, .18);
}

.product-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.product-card-price {
    margin: 0;
    line-height: 1;
    text-align: right;
    white-space: nowrap;
}

.product-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.product-page footer {
    margin-top: auto;
}

.product-hero {
    position: relative;
    min-height: 430px !important;
    display: flex;
    align-items: center;
    text-align: center;
    overflow: hidden;
    padding: 105px 0 70px;
    background:
        radial-gradient(circle at top right, rgba(212, 175, 55, .16), transparent 36%),
        radial-gradient(circle at bottom left, rgba(30, 144, 255, .13), transparent 34%);
}

.product-hero-content {
    position: relative;
    z-index: 2;
}

.product-price-top {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 92px;
    padding: 12px 18px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    color: #111;
    font-size: 1.55rem;
    font-weight: 800;
    box-shadow: 0 12px 28px rgba(0, 0, 0, .24);
}

.product-logo-large-wrap {
    width: 130px;
    height: 130px;
    margin: 0 auto 22px;
    border-radius: 30px;
    background: rgba(255, 255, 255, .96);
    border: 1px solid rgba(255, 255, 255, .28);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, .25);
}

.product-logo-large {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.product-hero h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.15;
    margin-bottom: 18px;
}

.product-hero p {
    max-width: 720px;
    margin: 0 auto 26px;
    color: var(--text-muted);
    font-size: 1.08rem;
}

.product-detail-section {
    padding-top: 36px;
}

.product-detail-card {
    max-width: 900px;
    margin: 0 auto;
}

.product-detail-card h3 {
    margin-bottom: 16px;
}

.product-detail-card hr {
    border: 0;
    height: 1px;
    background: var(--card-border);
    margin: 22px 0;
}

.product-detail-card p {
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 24px;
}

/* Footer stays visible and consistent on product pages */
footer {
    background: rgba(255, 255, 255, .03);
}

@media(max-width:768px) {
    .product-card-head {
        gap: 12px;
    }

    .product-logo-wrap {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        padding: 10px;
    }

    .product-price-top {
        position: static;
        display: inline-block;
        margin-bottom: 18px;
    }

    .product-logo-large-wrap {
        width: 110px;
        height: 110px;
        border-radius: 24px;
        padding: 20px;
    }
}

/* =====================================
   FINAL COMPACT SPACING OVERRIDE
   Put at the END so it wins over duplicated rules above.
===================================== */
:root {
    --section-space: 36px;
    --section-space-sm: 24px;
    --card-space: 22px;
}

/* Homepage hero: smaller vertical height before Featured Products */
.hero {
    min-height: 56vh !important;
    padding: 58px 0 42px !important;
}

.hero-badge {
    margin-bottom: 14px !important;
    padding: 7px 14px !important;
}

.hero h1 {
    margin-bottom: 14px !important;
}

.hero p {
    margin-bottom: 0 !important;
}

.hero-buttons {
    margin-top: 22px !important;
}

/* All main sections: reduce top/bottom gap */
.features,
.products-section,
.about-section,
.contact-section {
    padding-top: var(--section-space) !important;
    padding-bottom: var(--section-space) !important;
}

/* First section after hero should feel closer */
.features {
    padding-top: 28px !important;
}

/* Product section heading */
.section-title {
    margin-bottom: 24px !important;
}

.section-title h2 {
    margin-bottom: 6px !important;
}

.category-title {
    margin: 28px 0 14px !important;
}

.products-grid {
    gap: 18px !important;
}

.product-card,
.feature-card {
    padding: var(--card-space) !important;
}

.product-card-head {
    margin-bottom: 12px !important;
}

.product-card h3 {
    margin-bottom: 12px !important;
}

.product-card ul {
    margin-bottom: 14px !important;
}

.product-card li {
    margin-bottom: 7px !important;
}

.price,
.product-card-price {
    margin-bottom: 12px !important;
}

.contact-card {
    padding: 32px !important;
}

footer {
    padding-top: 34px !important;
    padding-bottom: 34px !important;
}

.footer-links {
    margin: 12px 0 !important;
}

/* Product detail pages */
.product-page .hero,
.product-page .product-hero,
.product-hero {
    min-height: 300px !important;
    padding: 74px 0 38px !important;
}

.product-logo-large-wrap {
    width: 100px !important;
    height: 100px !important;
    margin-bottom: 14px !important;
    border-radius: 24px !important;
    padding: 18px !important;
}

.product-hero h1 {
    margin-bottom: 10px !important;
}

.product-hero p {
    margin-bottom: 16px !important;
}

.product-detail-section,
.product-page .products-section {
    padding-top: 22px !important;
    padding-bottom: 28px !important;
}

.product-detail-card hr {
    margin: 14px 0 !important;
}

.product-detail-card p {
    margin-bottom: 16px !important;
}

/* Mobile compact spacing */
@media(max-width:768px) {
    .hero {
        min-height: 52vh !important;
        padding: 46px 0 34px !important;
    }

    .features,
    .products-section,
    .about-section,
    .contact-section {
        padding-top: 28px !important;
        padding-bottom: 28px !important;
    }

    .section-title {
        margin-bottom: 18px !important;
    }

    .category-title {
        margin: 22px 0 12px !important;
    }

    .product-page .hero,
    .product-page .product-hero,
    .product-hero {
        min-height: auto !important;
        padding: 56px 0 30px !important;
    }
}
